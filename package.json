{
  "name": "nihayah-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "deploy": "npx expo export -p web && npx eas-cli@latest deploy",
    "lint": "expo lint",
    "prettier": "prettier --write \"./**/*.{ts,js,jsx,tsx}\"",
    "prettier:check": "prettier --check \"./**/*.{ts,js,jsx,tsx}\"",
    "precommit": "npm run prettier && npm run lint"
  },
  "dependencies": {
    "@expo-google-fonts/noto-sans-arabic": "^0.4.0",
    "@expo/vector-icons": "^14.1.0",
    "expo": "^53.0.4",
    "expo-constants": "~17.1.4",
    "expo-font": "~13.3.2",
    "expo-linking": "~7.1.4",
    "expo-router": "~5.1.4",
    "expo-splash-screen": "~0.30.10",
    "expo-sqlite": "~15.2.14",
    "expo-status-bar": "~2.2.3",
    "jotai": "^2.12.5",
    "nativewind": "^4.0.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.5",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-web": "^0.20.0",
    "tailwindcss": "^3.4.0"
